# Production database connection. Use the Supabase pooler URL in Vercel.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"
# Prisma migration only; use the direct Supabase PostgreSQL connection on port 5432.
DIRECT_URL="postgresql://USER:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# 使用高熵随机字符串（至少 32 字符），只保存在本机。
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
BETTER_AUTH_URL="https://your-domain.example"

# Global background images are written server-side to this public Storage bucket.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-server-only-service-role-key"
SUPABASE_BACKGROUND_BUCKET="site-backgrounds"

# 当前公开作品搜索不需要 Token。预留给未来需要鉴权的同步功能。
ANILIST_ACCESS_TOKEN=""
VNDB_TOKEN=""

# Bangumi 官方要求非浏览器客户端提供包含个人 ID 与应用名的 User-Agent。
BANGUMI_USER_AGENT="your-bangumi-id/yoru-library"
BANGUMI_ACCESS_TOKEN=""
